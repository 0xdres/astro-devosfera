---
type Props = {
  id: string;
  label?: string;
};

const { id, label = "Image viewer" } = Astro.props;
---

<dialog
  id={id}
  class="lightbox"
  data-gallery-lightbox
  aria-label={label}
  aria-modal="true"
>
  <div class="lightbox-layout">
    <div class="lightbox-topbar">
      <span class="lightbox-counter font-firacode" data-lb-counter></span>
      <button
        class="lightbox-btn"
        data-lb-close
        aria-label="Close"
        title="Close (Esc)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="lightbox-main">
      <button
        class="lightbox-btn lightbox-nav lightbox-prev"
        data-lb-prev
        aria-label="Previous"
        title="Previous (Left Arrow)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-figure">
        <img
          src=""
          alt=""
          class="lightbox-image"
          decoding="async"
          data-lb-img
        />
        <p class="lightbox-caption text-foreground/80" data-lb-caption></p>
      </div>

      <button
        class="lightbox-btn lightbox-nav lightbox-next"
        data-lb-next
        aria-label="Next"
        title="Next (Right Arrow)"
        type="button"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</dialog>

<script>
  let lightboxController: AbortController | null = null;

  function initLightboxes() {
    lightboxController?.abort();
    lightboxController = new AbortController();
    const { signal } = lightboxController;

    document
      .querySelectorAll<HTMLDialogElement>("[data-gallery-lightbox]")
      .forEach(dialog => {
        const items = Array.from(
          document.querySelectorAll<HTMLButtonElement>(
            `button[data-lb="${dialog.id}"]`
          )
        );
        if (items.length === 0) return;

        const lbImg = dialog.querySelector<HTMLImageElement>("[data-lb-img]");
        const lbCaption =
          dialog.querySelector<HTMLElement>("[data-lb-caption]");
        const lbCounter =
          dialog.querySelector<HTMLElement>("[data-lb-counter]");
        const closeBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-close]");
        const prevBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-prev]");
        const nextBtn =
          dialog.querySelector<HTMLButtonElement>("[data-lb-next]");

        let current = 0;

        function open(idx: number) {
          current = Math.max(0, Math.min(idx, items.length - 1));
          const img = items[current]?.querySelector("img");
          if (!img || !lbImg) return;
          lbImg.src = img.src;
          lbImg.alt = img.alt;
          if (lbCaption) lbCaption.textContent = img.alt;
          if (lbCounter)
            lbCounter.textContent = `${current + 1} / ${items.length}`;
          if (prevBtn)
            prevBtn.style.visibility = current === 0 ? "hidden" : "visible";
          if (nextBtn)
            nextBtn.style.visibility =
              current === items.length - 1 ? "hidden" : "visible";
          if (!dialog.open) dialog.showModal();
          document.body.style.overflow = "hidden";
        }

        function close() {
          dialog.close();
          document.body.style.overflow = "";
        }

        items.forEach((btn, idx) => {
          btn.addEventListener("click", () => open(idx), { signal });
        });

        closeBtn?.addEventListener("click", close, { signal });
        prevBtn?.addEventListener("click", () => open(current - 1), { signal });
        nextBtn?.addEventListener("click", () => open(current + 1), { signal });

        dialog.addEventListener(
          "click",
          e => {
            const target = e.target as HTMLElement;
            if (
              !target.closest(
                "img, button, .lightbox-caption, .lightbox-counter"
              )
            ) {
              close();
            }
          },
          { signal }
        );

        dialog.addEventListener(
          "close",
          () => {
            document.body.style.overflow = "";
          },
          { signal }
        );

        document.addEventListener(
          "keydown",
          e => {
            if (!dialog.open) return;
            if (e.key === "Escape") close();
            if (e.key === "ArrowLeft") open(current - 1);
            if (e.key === "ArrowRight") open(current + 1);
          },
          { signal }
        );
      });

    document.addEventListener(
      "astro:before-swap",
      () => {
        document.body.style.overflow = "";
        lightboxController?.abort();
      },
      { once: true, signal }
    );
  }

  initLightboxes();
  document.addEventListener("astro:page-load", initLightboxes);
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    max-width: 100vw;
    max-height: 100dvh;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    background: var(--background);
    border: none;
    z-index: 100;
    color: var(--foreground);
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
  }

  .lightbox[open] {
    opacity: 1;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox-layout {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .lightbox-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    flex-shrink: 0;
  }

  .lightbox-counter {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
  }

  .lightbox-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1rem 1.5rem;
    min-height: 0;
    gap: 1.5rem;
  }

  .lightbox-figure {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: 100%;
    gap: 1.25rem;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
  }

  .lightbox-caption {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--foreground) 80%, transparent);
    text-align: center;
    max-width: 50ch;
    line-height: 1.5;
    margin: 0;
    font-weight: 300;
  }

  .lightbox-btn {
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 15%, transparent);
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0.75rem;
    border-radius: 50%;
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 12px
      color-mix(in srgb, var(--background) 50%, transparent);
  }

  .lightbox-btn:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    transform: scale(1.05) translateY(-2px);
    box-shadow: 0 8px 24px -4px
      color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .lightbox-nav {
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .lightbox-main {
      padding: 0 0 1rem 0;
      gap: 0;
      position: relative;
    }
    .lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      padding: 1rem 0.5rem;
    }
    .lightbox-nav:hover {
      transform: translateY(-50%) scale(1.1);
    }
    .lightbox-prev {
      left: 0;
    }
    .lightbox-next {
      right: 0;
    }
    .lightbox-image {
      max-height: calc(100dvh - 8rem);
    }
  }
</style>
