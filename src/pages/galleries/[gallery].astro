---
import { Image } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Datetime from "@/components/Datetime.astro";
import IconGallery from "@/assets/icons/IconGallery.svg";
import { slugifyStr } from "@/utils/slugify";
import { SITE } from "@/config";
import { useTranslations } from "@/i18n/utils";
import { getGalleryImages, type GalleryImage } from "@/utils/gallery";
import { buildGalleryStaticPaths } from "@/utils/staticPaths";
import GalleryLightbox from "@/components/GalleryLightbox.astro";

export const getStaticPaths = () => buildGalleryStaticPaths("en");

const { entry } = Astro.props;
const { gallery: slug } = Astro.params;
const { title, description, pubDatetime, coverImage, tags } = entry.data;

const locale = Astro.currentLocale || "en";
const t = useTranslations(locale);
const prefix = locale === "es" ? "/es" : "";

const images: GalleryImage[] = getGalleryImages(slug, locale, title);

// If the frontmatter has coverImage, include it at the beginning if it is not already in the list
const hasCoverInFolder = coverImage
  ? images.some(img => img.src.src === coverImage.src)
  : false;

const coverImageSrc = coverImage
  ? new URL(coverImage.src, Astro.url.origin).href
  : images.length > 0
    ? new URL(images[0].src.src, Astro.url.origin).href
    : undefined;

// Build Schema.org ImageGallery Structured Data
const gallerySchema = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: title,
  description: description,
  url: new URL(Astro.url.pathname, SITE.website).toString(),
  ...(coverImageSrc && { image: coverImageSrc }),
  creator: {
    "@type": "Person",
    name: SITE.author,
    ...(SITE.profile && { url: SITE.profile }),
  },
  numberOfItems: images.length,
};
---

<Layout
  title={`${title} | ${t("nav.galleries")} | ${SITE.title}`}
  description={description}
  ogImage={coverImageSrc}
  structuredData={gallerySchema}
>
  <Header />
  {SITE.showBackButton && <Breadcrumb withBackButton />}
  <main
    id="main-content"
    class:list={["relative app-layout pb-16", { "mt-8": !SITE.showBackButton }]}
  >
    <!-- Gallery header -->
    <header class="mb-14 border-b border-border/10 pt-8 pb-10 sm:pb-14">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl">
          <div class="mb-5 inline-flex items-center gap-2 text-accent">
            <IconGallery class="size-5" />
            <span class="font-firacode text-xs font-bold tracking-[0.2em] uppercase opacity-90">
              {t("galleries.collection")} // {images.length}
              {images.length === 1
                ? t("galleries.photo")
                : t("galleries.photos")}
            </span>
          </div>

          <h1
            class="text-4xl font-extrabold tracking-tight text-foreground sm:text-5xl lg:text-5xl xl:text-6xl"
            style={{
              viewTransitionName: slugifyStr(
                String(title).replaceAll(".", "-")
              ),
            }}
          >
            {title}
          </h1>

          {description && (
            <p class="mt-6 text-lg leading-relaxed text-foreground/60 sm:text-xl">
              {description}
            </p>
          )}
        </div>

        <div class="flex w-full shrink-0 flex-col gap-4 md:w-auto md:items-end md:pb-2">
          <div class="inline-flex items-center gap-2 font-firacode text-sm text-foreground/40">
            <svg
              class="size-4 opacity-50"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <Datetime pubDatetime={pubDatetime} class="mb-0 [&>svg]:hidden" />
          </div>

          {tags.length > 0 && (
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm md:mt-0 md:justify-end">
              {tags.map(tag => (
                <a
                  href={`${prefix}/tags/${slugifyStr(tag)}/`}
                  class="group relative inline-flex items-center font-firacode text-foreground/75 transition-colors duration-300 hover:text-accent"
                >
                  <span class="mr-1 text-accent/70 transition-colors duration-300 group-hover:text-accent">
                    #
                  </span>
                  {tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- Large cover (if defined in frontmatter and not in the folder) -->
    {coverImage && !hasCoverInFolder && (
      <div class="mb-8 overflow-hidden rounded-2xl">
        <Image
          src={coverImage}
          alt={title}
          class="max-h-[60vh] w-full object-cover"
          loading="eager"
          fetchpriority="high"
          widths={[800, 1200, 1600]}
          sizes="(max-width: 1200px) 100vw, 1200px"
          format="avif"
          quality={72}
        />
      </div>
    )}

    <!-- Image grid -->
    {images.length > 0 ? (
      <ul
        class="gallery-grid mt-6"
        id="gallery-grid"
        role="list"
        aria-label={`Images of ${title}`}
      >
        {images.map((img, idx) => (
          <li>
            <button
              class="gallery-item group"
              data-lb="lightbox"
              data-index={idx}
              aria-label={`View image: ${img.alt}`}
              type="button"
            >
              <Image
                src={img.src}
                alt={img.alt}
                class="gallery-img"
                loading={idx < 3 ? "eager" : "lazy"}
                fetchpriority={idx < 2 ? "high" : "auto"}
                widths={[400, 800]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                format="avif"
                quality={72}
              />
              <div class="gallery-item-overlay">
                <span class="gallery-item-alt">{img.alt}</span>
              </div>
            </button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-12 text-center text-foreground/50 italic">
        {t("galleries.noImages")}
      </p>
    )}
  </main>
  <Footer />
</Layout>

{images.length > 0 && <GalleryLightbox id="lightbox" label="Image viewer" />}

<style>
  /* ── Image grid ── */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.75rem;
    cursor: zoom-in;
    background: color-mix(in srgb, var(--foreground) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--border) 25%, transparent);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
    padding: 0;
  }

  .gallery-item:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    box-shadow: 0 4px 24px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.05);
  }

  .gallery-item-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
    background: linear-gradient(
      to top,
      color-mix(in srgb, black 60%, transparent) 0%,
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }

  .gallery-item:hover .gallery-item-overlay,
  .gallery-item:focus-visible .gallery-item-overlay {
    opacity: 1;
  }

  .gallery-item-alt {
    font-size: 0.75rem;
    color: white;
    line-height: 1.3;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
</style>
